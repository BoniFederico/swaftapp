{
  "name": "swaft",
  "version": "1.0.0",
  "private": true,
  "description": "Swaft — Strange Workspace App for Technician (Electron desktop app)",
  "license": "MIT",
  "homepage": "https://bonifederico.github.io/swaftapp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BoniFederico/swaftapp.git"
  },
  "bugs": {
    "url": "https://github.com/BoniFederico/swaftapp/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace @swaft/desktop run dev",
    "build": "npm --workspace @swaft/desktop run build",
    "start": "npm --workspace @swaft/desktop run start",
    "dist": "npm --workspace @swaft/desktop run package",
    "dist:dir": "npm --workspace @swaft/desktop run package:dir",
    "typecheck": "npm --workspace @swaft/shared run typecheck && npm --workspace @swaft/desktop run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "screenshots": "npm run build && playwright test -c scripts/screenshots",    "see": "npm run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.7.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
