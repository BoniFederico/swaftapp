{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swaft.app/schemas/template.schema.json",
  "title": "Swaft template metadata (templates/<slug>.<shortId>/template.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "folderId", "projectId", "name", "type", "subtype", "hasDraft", "tags"],
  "properties": {
    "id": { "type": "string" },
    "folderId": { "type": "string" },
    "projectId": { "type": ["string", "null"] },
    "name": { "type": "string" },
    "type": { "type": "string" },
    "subtype": { "type": ["string", "null"] },
    "hasDraft": { "type": "boolean" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth": { "type": "object" },
        "actions": { "type": "array" }
      }
    }
  }
}
