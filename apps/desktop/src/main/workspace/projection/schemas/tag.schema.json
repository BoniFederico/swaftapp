{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swaft.app/schemas/tag.schema.json",
  "title": "Swaft tag (tags/<slug>.<shortId>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "color"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "color": { "type": ["string", "null"] }
  }
}
