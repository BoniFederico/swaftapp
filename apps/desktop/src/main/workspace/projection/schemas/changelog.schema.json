{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swaft.app/schemas/changelog.schema.json",
  "title": "Swaft changelog entry (changelog/<slug>.<shortId>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "entityType", "entityId", "message", "username"],
  "properties": {
    "id": { "type": "string" },
    "entityType": { "type": "string" },
    "entityId": { "type": "string" },
    "message": { "type": ["string", "null"] },
    "username": { "type": ["string", "null"] }
  }
}
